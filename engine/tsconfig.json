{
    "compilerOptions": {
        "lib": ["ESNext", "dom"],
        "target": "ESNext",
        "module": "node16",
        "moduleResolution": "node16",
        "isolatedModules": true,
        "esModuleInterop": true,
        "declaration": true,
        "outDir": "./dist",
        "rootDir": "./src"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "test", "dist"]
}
