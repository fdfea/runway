{
    "compilerOptions": {
        "lib": ["esnext", "dom"],
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "outDir": "dist/",
        "rootDir": "src/",
        "isolatedModules": true,
        "esModuleInterop": true,
        "declaration": true,
        "strict": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "test", "dist"]
}
