{
    "compilerOptions": {
        "lib": ["esnext", "dom"],
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "esModuleInterop": true,
        "declaration": true,
        "outDir": "dist/",
        "rootDir": "src/",
        "strict": true
    },
    "include": ["src/**/*", "test/**/*"],
    "exclude": ["node_modules", "dist"],
    "references": [
        { "path": "./tsconfig.test.json" }
    ]
}
